# VantageOps — Client environment configuration
# Copy this file to config/CLIENTNAME.env and fill in your values
# NEVER commit .env files with real credentials to git

TERADATA_HOST=your_teradata_host_or_ip
TERADATA_USER=your_username
TERADATA_PASSWORD=your_password
TERADATA_DATABASE=your_default_database

# Optional threshold overrides (defaults in core/config.py)
# STATS_STALE_DAYS=15
# SPACE_CRITICAL_PCT=80
# SPACE_WARNING_PCT=60
